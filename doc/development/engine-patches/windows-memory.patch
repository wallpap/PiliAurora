+void Shell::HandleCpuMemoryMessage(std::unique_ptr<PlatformMessage> message) {
+  const auto response = message->response();
+  const auto& data = message->data();
+  rapidjson::Document request;
+  request.Parse(reinterpret_cast<const char*>(data.GetMapping()), data.GetSize());
+  if (request.HasParseError() || !request.IsObject() ||
+      !request.HasMember("method") || !request["method"].IsString()) {
+    if (response) response->CompleteEmpty();
+    return;
+  }
+  const std::string method(request["method"].GetString());
+  if (method != "sample" && method != "purgeResource" &&
+      method != "purgeFont" && method != "purgeHarfBuzz") {
+    if (response) response->CompleteEmpty();
+    return;
+  }
+  static std::atomic<uint64_t> sequence{0};
+  const uint64_t sample_id = ++sequence;
+  auto* ui_runner = task_runners_.GetUITaskRunner().get();
+  // 避开 Dart native 调用栈；只调用有自身同步的 CPU 缓存 API，不访问 GL/context。
+  task_runners_.GetUITaskRunner()->PostTask(
+      [engine = engine_->GetWeakPtr(), response, method, sample_id, ui_runner] {
+        const auto started = fml::TimePoint::Now();
+        // Embedder runner 没有 FML queue id；必须走 virtual 回调判定真实线程。
+        // 有效 Engine 的 task_runners_ 持有 runner；weak 失效后不解引用非拥有指针。
+        // 不让待执行闭包强持自己的 runner，避免停止阶段形成循环引用。
+        const bool on_ui = engine && ui_runner->RunsTasksOnCurrentThread();
+        rapidjson::Document envelope;
+        envelope.SetArray();
+        auto& allocator = envelope.GetAllocator();
+        rapidjson::Value result(rapidjson::kObjectType);
+        result.AddMember("schemaVersion", 1, allocator);
+        result.AddMember("sampleId", sample_id, allocator);
+        result.AddMember("action", rapidjson::StringRef(method.c_str()), allocator);
+        result.AddMember("thread", "ui", allocator);
+        result.AddMember("uiThread", on_ui, allocator);
+        result.AddMember("threadValidation", "virtualTaskRunnerRunsTasksOnCurrentThread", allocator);
+        result.AddMember("coverage", "processGlobalCpuCaches; independentlyLockedCounters", allocator);
+        int64_t action_duration_us = 0;
+        if (!engine || !on_ui) {
+          result.AddMember("status", "unavailable", allocator);
+          result.AddMember("reason", rapidjson::StringRef(!engine ? "engineStopped" : "unexpectedThread"), allocator);
+        } else {
+          if (method != "sample") {
+            auto before = CpuMemoryCounters(allocator);
+            result.AddMember("before", before, allocator);
+            const auto action_started = fml::TimePoint::Now();
+            if (method == "purgeResource") {
+              SkGraphics::PurgeResourceCache();
+            } else if (method == "purgeFont") {
+              SkGraphics::PurgeFontCache();
+            } else {
+              SkShapers::HB::PurgeCaches();
+            }
+            action_duration_us = (fml::TimePoint::Now() - action_started).ToMicroseconds();
+          }
+          auto after = CpuMemoryCounters(allocator);
+          result.AddMember("after", after, allocator);
+          result.AddMember("status", rapidjson::StringRef(method == "sample" ? "sampled" : "purged"), allocator);
+        }
+        result.AddMember("actionDurationUs", action_duration_us, allocator);
+        result.AddMember("durationUs", (fml::TimePoint::Now() - started).ToMicroseconds(), allocator);
+        envelope.PushBack(result, allocator);
+        if (response) {
+          const auto json = GraphicsMemoryJson(envelope);
+          std::vector<uint8_t> bytes(json.begin(), json.end());
+          response->Complete(std::make_unique<fml::DataMapping>(std::move(bytes)));
+        }
+      });
+}
