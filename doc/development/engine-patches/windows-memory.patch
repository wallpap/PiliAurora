+void Shell::HandleVmMemoryMessage(std::unique_ptr<PlatformMessage> message) {
+  const auto response = message->response();
+  const auto& data = message->data();
+  rapidjson::Document request;
+  request.Parse(reinterpret_cast<const char*>(data.GetMapping()), data.GetSize());
+  if (request.HasParseError() || !request.IsObject() ||
+      !request.HasMember("method") || !request["method"].IsString()) {
+    if (response) response->CompleteEmpty();
+    return;
+  }
+  const std::string method(request["method"].GetString());
+  if (method != "vmSample" && method != "collectDart" && method != "collectDartFull") {
+    if (response) response->CompleteEmpty();
+    return;
+  }
+  // 延后一条 UI task，避开调用 Dart sendPlatformMessage 的 native 栈和现有锁。
+  task_runners_.GetUITaskRunner()->PostTask(
+      [engine = engine_->GetWeakPtr(), response, method] {
+        rapidjson::Document envelope;
+        envelope.SetArray();
+        auto& allocator = envelope.GetAllocator();
+        rapidjson::Value result(rapidjson::kObjectType);
+        result.AddMember("schemaVersion", 1, allocator);
+        result.AddMember("action", rapidjson::StringRef(method.c_str()), allocator);
+        auto isolate = engine ? engine->GetRuntimeController()->GetRootIsolate().lock() : nullptr;
+        if (!isolate) {
+          result.AddMember("status", "unavailable", allocator);
+          result.AddMember("reason", "rootIsolateNotRunning", allocator);
+        } else {
+          // RuntimeController 返回 const 视图；底层 root DartState 仍由 VM 管理且可进入。
+          auto root_state = std::const_pointer_cast<DartIsolate>(isolate);
+          tonic::DartIsolateScope isolate_scope(root_state->isolate());
+          Dart_IsolateGroup group = Dart_CurrentIsolateGroup();
+          if (!group) {
+            result.AddMember("status", "unavailable", allocator);
+            result.AddMember("reason", "noCurrentIsolateGroup", allocator);
+          } else {
+            const auto read = [&](rapidjson::Value& target) {
+              target.AddMember("oldUsedBytes", Dart_IsolateGroupHeapOldUsedMetric(group), allocator);
+              target.AddMember("oldCapacityBytes", Dart_IsolateGroupHeapOldCapacityMetric(group), allocator);
+              target.AddMember("oldExternalBytes", Dart_IsolateGroupHeapOldExternalMetric(group), allocator);
+              target.AddMember("newUsedBytes", Dart_IsolateGroupHeapNewUsedMetric(group), allocator);
+              target.AddMember("newCapacityBytes", Dart_IsolateGroupHeapNewCapacityMetric(group), allocator);
+              target.AddMember("newExternalBytes", Dart_IsolateGroupHeapNewExternalMetric(group), allocator);
+            };
+            if (method != "vmSample") {
+              rapidjson::Value before(rapidjson::kObjectType);
+              read(before);
+              result.AddMember("before", before, allocator);
+              const auto started = fml::TimePoint::Now();
+              if (method == "collectDartFull") {
+                // 仅显式诊断动作。公开 API 在本固定版本会 compact+CollectAllGarbage。
+                Dart_NotifyDestroyed();
+              } else {
+                // 本版本只清 VM page/zone 缓存，并不执行 GC。
+                Dart_NotifyLowMemory();
+              }
+              result.AddMember("durationUs", (fml::TimePoint::Now() - started).ToMicroseconds(), allocator);
+              result.AddMember("api", rapidjson::StringRef(method == "collectDartFull" ? "Dart_NotifyDestroyed" : "Dart_NotifyLowMemory"), allocator);
+              result.AddMember("requestedGc", method == "collectDartFull", allocator);
+            }
+            read(result);
+            const auto capacity = Dart_IsolateGroupHeapOldCapacityMetric(group) + Dart_IsolateGroupHeapNewCapacityMetric(group);
+            result.AddMember("status", rapidjson::StringRef(capacity > 0 ? "sampled" : "unavailable"), allocator);
+            result.AddMember("coverage", "rootIsolateGroupOnly; otherGroupsNotSummed", allocator);
+            result.AddMember("newUsedSemantics", "capacityProxy; VM metric avoids TLAB data race", allocator);
+            result.AddMember("externalSemantics", "VM external accounting; not resident or uniquely owned native bytes", allocator);
+          }
+        }
+        envelope.PushBack(result, allocator);
+        if (response) {
+          const auto json = GraphicsMemoryJson(envelope);
+          std::vector<uint8_t> bytes(json.begin(), json.end());
+          response->Complete(std::make_unique<fml::DataMapping>(std::move(bytes)));
+        }
+      });
+}
