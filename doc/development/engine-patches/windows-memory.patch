+void Shell::HandleGraphicsMemoryMessage(std::unique_ptr<PlatformMessage> message) {
+  const auto response = message->response();
+  const auto& data = message->data();
+  rapidjson::Document request;
+  request.Parse(reinterpret_cast<const char*>(data.GetMapping()), data.GetSize());
+  if (request.HasParseError() || !request.IsObject() ||
+      !request.HasMember("method") || !request["method"].IsString()) {
+    if (response) response->CompleteEmpty();
+    return;
+  }
+  const std::string method(request["method"].GetString());
+  bool resources = true;
+  std::string purge_context;
+  if (request.HasMember("args") && request["args"].IsObject()) {
+    const auto& args = request["args"];
+    if (args.HasMember("resources") && args["resources"].IsBool()) resources = args["resources"].GetBool();
+    if (args.HasMember("context") && args["context"].IsString()) purge_context = args["context"].GetString();
+  }
+  if ((method != "sample" && method != "purge" && method != "freeGpuResources") ||
+      (method == "purge" && purge_context != "io" && purge_context != "raster" && purge_context != "rasterCache" &&
+       purge_context != "flushIO" && purge_context != "flushRaster") ||
+      (method == "freeGpuResources" && purge_context != "io" && purge_context != "raster")) {
+    if (response) response->CompleteEmpty();
+    return;
+  }
+  if (method == "sample") purge_context.clear();
+  static std::atomic<uint64_t> sequence{0};
+  const uint64_t sample_id = ++sequence;
+  // 两个线程依次生成独立快照；不在平台/UI线程等待，也不跨线程访问 context。
+  task_runners_.GetIOTaskRunner()->PostTask(
+      [manager = io_manager_, rasterizer = rasterizer_->GetWeakPtr(),
+       runner = task_runners_.GetRasterTaskRunner(), response,
+       resources, purge_context, method, sample_id] {
+        std::string io = "{\"available\":false,\"gpuDisabled\":true}";
+        bool gpu_disabled = true;
+        manager->GetIsGpuDisabledSyncSwitch()->Execute(
+            fml::SyncSwitch::Handlers().SetIfFalse([&] {
+              gpu_disabled = false;
+              auto context = manager->GetResourceContext();
+              auto result = CaptureGraphicsMemory(context.get(), resources, method == "purge" && purge_context == "io", method == "purge" && purge_context == "flushIO", method == "freeGpuResources" && purge_context == "io", "io");
+              io = GraphicsMemoryJson(result);
+            }));
+        runner->PostTask([rasterizer, response, resources, purge_context, method,
+                          gpu_disabled, sample_id, io = std::move(io)] {
+          std::string raster = "{\"available\":false}";
+          if (rasterizer && !gpu_disabled) {
+            raster = rasterizer->GetGraphicsMemoryInfo(resources, method == "purge" && purge_context == "raster", method == "purge" && purge_context == "rasterCache", method == "purge" && purge_context == "flushRaster", method == "freeGpuResources" && purge_context == "raster");
+          }
+          if (response) {
+            const std::string json = "[{\"status\":\"sampled\",\"schemaVersion\":2,"
+                "\"semantics\":\"Skia dump subentry count and nominal sizes; budgeted stats separate; shared GL backing may appear in both contexts\","
+                "\"action\":\"" + (method == "freeGpuResources" ? method : purge_context.empty() ? std::string("sample") : purge_context) + "\",\"sampleId\":" + std::to_string(sample_id) + ",\"contexts\":{\"raster\":" + raster + ",\"io\":" + io + "}}]";
+            std::vector<uint8_t> bytes(json.begin(), json.end());
+            response->Complete(std::make_unique<fml::DataMapping>(std::move(bytes)));
+          }
+        });
+      });
+}
