+std::string Rasterizer::GetGraphicsMemoryInfo(bool resources, bool purge,
+                                               bool clear_raster_cache, bool flush, bool free_gpu) {
+  std::string json = "{\"available\":false,\"gpuDisabled\":true}";
+#if !SLIMPELLER
+  delegate_.GetIsGpuDisabledSyncSwitch()->Execute(
+      fml::SyncSwitch::Handlers().SetIfFalse([&] {
+        json = "{\"available\":false}";
+        if (!surface_) return;
+        auto current = surface_->MakeRenderContextCurrent();
+        if (!current || !current->GetResult()) return;
+        auto& cache = compositor_context_->raster_cache();
+        const auto layer_before = cache.EstimateLayerCacheByteSize();
+        const auto picture_before = cache.EstimatePictureCacheByteSize();
+        const auto entries_before = cache.GetCachedEntriesCount();
+        if (clear_raster_cache) cache.Clear();
+        auto result = CaptureGraphicsMemory(surface_->GetContext(), resources, purge, flush, free_gpu, "raster");
+        auto& allocator = result.GetAllocator();
+        result.AddMember("rasterCacheLayerBytes", static_cast<uint64_t>(cache.EstimateLayerCacheByteSize()), allocator);
+        result.AddMember("rasterCachePictureBytes", static_cast<uint64_t>(cache.EstimatePictureCacheByteSize()), allocator);
+        result.AddMember("rasterCacheEntries", static_cast<uint64_t>(cache.GetCachedEntriesCount()), allocator);
+        if (clear_raster_cache) {
+          result.AddMember("rasterCacheLayerBytesBeforeClear", static_cast<uint64_t>(layer_before), allocator);
+          result.AddMember("rasterCachePictureBytesBeforeClear", static_cast<uint64_t>(picture_before), allocator);
+          result.AddMember("rasterCacheEntriesBeforeClear", static_cast<uint64_t>(entries_before), allocator);
+        }
+        json = GraphicsMemoryJson(result);
+      }));
+#endif
+  return json;
+}
