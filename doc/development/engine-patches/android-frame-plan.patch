+void VsyncWaiterAndroid::OnFrameTimeline(
+    const AChoreographerFrameCallbackData* data) {
+  const auto& table = impeller::android::GetProcTable();
+  const auto now = fml::TimePoint::Now();
+  const auto now_ns = now.ToEpochDelta().ToNanoseconds();
+  const auto start_ns = table.AChoreographerFrameCallbackData_getFrameTimeNanos(data);
+  std::vector<FrameTimeline> timelines;
+  for (size_t i = 0;
+       i < table.AChoreographerFrameCallbackData_getFrameTimelinesLength(data); ++i) {
+    timelines.push_back({
+        table.AChoreographerFrameCallbackData_getFrameTimelineVsyncId(data, i),
+        table.AChoreographerFrameCallbackData_getFrameTimelineExpectedPresentationTimeNanos(data, i),
+        table.AChoreographerFrameCallbackData_getFrameTimelineDeadlineNanos(data, i)});
+  }
+  auto plan = SelectFramePresentationPlan(start_ns, now_ns,
+      static_cast<int64_t>(1000000000.0 / g_refresh_rate_), timelines, feedback_,
+      last_expected_ns_);
+  if (!plan) {
+    // 当前回调立即交付普通帧，避免无效 timeline 让 UI 一直等待。
+    const auto start = fml::TimePoint::FromEpochDelta(
+        fml::TimeDelta::FromNanoseconds(std::min(start_ns, now_ns)));
+    const auto target = start + fml::TimeDelta::FromNanoseconds(
+        static_cast<int64_t>(1000000000.0 / g_refresh_rate_));
+    FireCallback(start, target);
+    return;
+  }
+  last_expected_ns_ = plan->expected_ns;
+  auto shared_plan = std::make_shared<const FramePresentationPlan>(*plan);
+  auto start = fml::TimePoint::FromEpochDelta(fml::TimeDelta::FromNanoseconds(
+      std::min(start_ns, now_ns)));
+  auto target = fml::TimePoint::FromEpochDelta(
+      fml::TimeDelta::FromNanoseconds(plan->expected_ns));
+  FireCallback(start, target, true, std::move(shared_plan));
+}
