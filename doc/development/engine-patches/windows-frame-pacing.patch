+TEST(TaskRunnerTest, TimerThreadRearmsParkedDeadline) {
+  std::promise<void> fired;
+  std::atomic_bool signaled = false;
+  TimerThread timer_thread([&]() {
+    if (!signaled.exchange(true)) {
+      fired.set_value();
+    }
+  });
+  timer_thread.Start();
+  // Let the worker enter its parked wait before giving it an earlier deadline.
+  std::this_thread::sleep_for(std::chrono::milliseconds(50));
+  timer_thread.ScheduleAt(std::chrono::high_resolution_clock::now() +
+                          std::chrono::milliseconds(20));
+  EXPECT_EQ(fired.get_future().wait_for(std::chrono::milliseconds(250)),
+            std::future_status::ready);
+  timer_thread.Stop();
+}
+
+TEST(TaskRunnerTest, TimerThreadMovesPendingDeadlineEarlier) {
+  std::promise<void> fired;
+  std::atomic_bool signaled = false;
+  TimerThread timer_thread([&]() {
+    if (!signaled.exchange(true)) {
+      fired.set_value();
+    }
+  });
+  timer_thread.ScheduleAt(std::chrono::high_resolution_clock::now() +
+                          std::chrono::seconds(10));
+  timer_thread.Start();
+  std::this_thread::sleep_for(std::chrono::milliseconds(50));
+  timer_thread.ScheduleAt(std::chrono::high_resolution_clock::now() +
+                          std::chrono::milliseconds(20));
+  EXPECT_EQ(fired.get_future().wait_for(std::chrono::milliseconds(250)),
+            std::future_status::ready);
+  timer_thread.Stop();
+}
