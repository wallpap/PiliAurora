+std::optional<WindowsProcTable::DwmFrameTiming>
+WindowsProcTable::GetDwmFrameTiming() const {
+  DWM_TIMING_INFO timing = {};
+  timing.cbSize = sizeof(timing);
+  LARGE_INTEGER counter = {};
+  LARGE_INTEGER frequency = {};
+  if (FAILED(::DwmGetCompositionTimingInfo(nullptr, &timing)) ||
+      !::QueryPerformanceCounter(&counter) ||
+      !::QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0 ||
+      timing.qpcVBlank == 0 || timing.qpcRefreshPeriod == 0) {
+    return std::nullopt;
+  }
+  return DwmFrameTiming{static_cast<int64_t>(timing.qpcVBlank),
+                        static_cast<int64_t>(timing.qpcRefreshPeriod),
+                        counter.QuadPart, frequency.QuadPart};
+}
