+TEST_F(AccessibilityChildLookupTest, PreservesValidChildAndSelfQueries) {
+  auto root = bridge_->GetFlutterPlatformNodeDelegateFromID(0).lock();
+  auto child = bridge_->GetFlutterPlatformNodeDelegateFromID(1).lock();
+  ASSERT_GE(root->GetChildCount(), 1);
+  EXPECT_EQ(root->ChildAtIndex(0), child->GetNativeViewAccessible());
+
+  VARIANT id{};
+  id.vt = VT_I4;
+  id.lVal = 1;
+  IDispatch* result = nullptr;
+  ASSERT_EQ(S_OK, root->GetNativeViewAccessible()->get_accChild(id, &result));
+  EXPECT_EQ(result, static_cast<IDispatch*>(child->GetNativeViewAccessible()));
+  ASSERT_NE(result, nullptr);
+  result->Release();
+
+  id.lVal = CHILDID_SELF;
+  result = nullptr;
+  ASSERT_EQ(S_OK, root->GetNativeViewAccessible()->get_accChild(id, &result));
+  EXPECT_EQ(result, static_cast<IDispatch*>(root->GetNativeViewAccessible()));
+  ASSERT_NE(result, nullptr);
+  result->Release();
+}
+
+TEST_F(AccessibilityChildLookupTest, ReturnsNullForOutOfRangeIndices) {
+  auto root = bridge_->GetFlutterPlatformNodeDelegateFromID(0).lock();
+  EXPECT_EQ(root->ChildAtIndex(-1), nullptr);
+  EXPECT_EQ(root->ChildAtIndex(root->GetChildCount()), nullptr);
+
+  VARIANT id{};
+  id.vt = VT_I4;
+  id.lVal = root->GetChildCount() + 1;
+  IDispatch* result = root->GetNativeViewAccessible();
+  EXPECT_EQ(E_INVALIDARG,
+            root->GetNativeViewAccessible()->get_accChild(id, &result));
+  EXPECT_EQ(result, nullptr);
+}
+
+TEST_F(AccessibilityChildLookupTest, RejectsMissingChildWithStaleCount) {
+  auto delegate =
+      std::make_unique<StaleChildCountDelegate>(bridge_, view_.get());
+  delegate->Init(bridge_, AXNodeFromID(bridge_, 1));
+  ASSERT_EQ(delegate->FlutterPlatformNodeDelegate::GetChildCount(), 0);
+  ASSERT_EQ(delegate->GetChildCount(), 1);
+
+  // 重现转储中的child_id=1：计数准入成功，但实际树没有第一个child。
+  VARIANT id{};
+  id.vt = VT_I4;
+  id.lVal = 1;
+  IDispatch* result = delegate->GetNativeViewAccessible();
+  EXPECT_EQ(E_INVALIDARG,
+            delegate->GetNativeViewAccessible()->get_accChild(id, &result));
+  EXPECT_EQ(result, nullptr);
+}
+
+TEST_F(AccessibilityChildLookupTest, ReturnsNullAfterOwnerBridgeExpires) {
+  auto detached_bridge = std::make_shared<AccessibilityBridgeWindowsSpy>(
+      engine_.get(), view_.get());
+  PopulateAXTree(detached_bridge);
+  auto delegate =
+      detached_bridge->GetFlutterPlatformNodeDelegateFromID(0).lock();
+  ASSERT_FALSE(delegate->GetOwnerBridge().expired());
+  detached_bridge.reset();
+  ASSERT_TRUE(delegate->GetOwnerBridge().expired());
+  EXPECT_EQ(delegate->ChildAtIndex(0), nullptr);
+}
